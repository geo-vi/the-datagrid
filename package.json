  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "community-api-manifest.json"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.scss",
    "./src/search/index.ts",
    "./src/toolbar/index.ts",
    "./src/packages/TextInput/index.tsx",
    "./dist/index.js",
    "./dist/index.cjs",
    "./dist/search.js",
    "./dist/search.cjs",
    "./dist/toolbar.js",
    "./dist/toolbar.cjs",
    "./dist/packages/TextInput/index.js"
  ],
  "keywords": [
    "react",
    "datagrid",
    "data-grid",
    "table",
    "shadcn",
    "tanstack-table",
    "virtualized",
    "filtering",
    "sorting"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/geo-vi/the-datagrid.git"
  },
  "scripts": {
    "build:search-index": "tsx scripts/build-docfind-index.ts",
    "dev": "yarn build:search-index && vite",
    "build": "yarn test:community-audit && yarn test:types && tsc -p ./tsconfig-build.json && vite build --mode library-core && vite build --mode library-search && vite build --mode library-toolbar && vite build --mode library-components && vite build --mode library-text-input && vite build --mode library-bool-editor && vite build --mode library-date-editor && vite build --mode library-numeric-editor && vite build --mode library-string-filter && vite build --mode library-bool-filter && vite build --mode library-date-filter && vite build --mode library-number-filter && vite build --mode library-select-filter && vite build --mode library-community-types && node scripts/prepare-community-artifacts.mjs && node scripts/fix-dts-specifiers.mjs && node scripts/test-published-types.mjs && node scripts/assert-css-scope.mjs && node scripts/assert-search-boundary.mjs && node scripts/assert-toolbar-boundary.mjs && node scripts/assert-components-boundary.mjs && node scripts/assert-text-input-boundary.mjs",
    "build:site": "yarn build:search-index && vite build --mode site",
    "build:site:e2e": "yarn build:search-index && vite build --mode site --base /",
    "lint": "eslint .",
    "test:types": "tsc -p ./tests/types/tsconfig.json --noEmit",
    "test:unit": "tsx --test tests/engine/**/*.test.ts",
    "test:community-audit": "node scripts/audit-community-api.mjs",
    "test:published-types": "node scripts/test-published-types.mjs",
    "test:react-compat": "node scripts/test-react-compat.mjs",
    "test:compat": "yarn test:types && playwright test tests/playwright/computed-props-compat.spec.ts",
    "test:css-scope": "node scripts/assert-css-scope.mjs",
    "test:e2e:prepare": "yarn build",
    "test:e2e:css-scope": "yarn test:e2e:prepare && playwright test tests/playwright/css-scope.spec.ts",
    "test:e2e": "yarn test:e2e:prepare && playwright test && yarn test:e2e:performance",
    "test:e2e:performance": "playwright test --config playwright.performance.config.ts",
    "test:e2e:headed": "yarn test:e2e:prepare && playwright test --headed",
    "test:e2e:ui": "yarn test:e2e:prepare && playwright test --ui",
    "test:e2e:install": "playwright install chromium",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\" \"examples/src/**/*.{ts,tsx,js,jsx,json,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\" \"examples/src/**/*.{ts,tsx,js,jsx,json,css}\"",
    "preview": "vite preview",
    "preview:e2e": "vite preview examples --outDir ../dist-site --base /",
    "preview:site": "vite preview examples --outDir ../dist-site --base /the-datagrid/ --host 0.0.0.0",
    "prepublishOnly": "npm run build",
    "publish-release": "npm run build && npm publish --tag latest --access public"
  },
  "dependencies": {
    "use-sync-external-store": "^1.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@inovua/reactdatagrid-community": "5.10.2",
    "@playwright/test": "^1.58.2",
    "@radix-ui/react-checkbox": "^1.3.3",
