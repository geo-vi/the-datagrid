    "./style/theme/amber-light/index.css": "./dist/style/theme/amber-light/index.css",
    "./style/theme/blue-dark/index.css": "./dist/style/theme/blue-dark/index.css",
    "./style/theme/blue-light/index.css": "./dist/style/theme/blue-light/index.css",
    "./style/theme/default-dark/index.css": "./dist/style/theme/default-dark/index.css",
    "./style/theme/default-light/index.css": "./dist/style/theme/default-light/index.css",
    "./style/theme/green-dark/index.css": "./dist/style/theme/green-dark/index.css",
    "./style/theme/green-light/index.css": "./dist/style/theme/green-light/index.css",
    "./style/theme/pink-dark/index.css": "./dist/style/theme/pink-dark/index.css",
